generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum StockMovementType {
  RECEIVE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ORDER_COMMIT
  RETURN_RESTOCK
  STOCKTAKE_RECONCILE
}

enum StockReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CHAPA
  COD
  MOCK_ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
  COD_COLLECTED
  COD_RECONCILED
}

enum PaymentTransactionStatus {
  INITIALIZED
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum RestockDecision {
  PENDING
  RESTOCKED
  DAMAGED_DISCARD
  NOT_APPLICABLE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ============================================================================
// 1. IDENTITY & RBAC
// ============================================================================

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String
  fullName        String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  preferredLocale String     @default("en")
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  otpVerifications    OtpVerification[]
  customerProfile     CustomerProfile?
  stockMovements      StockMovement[]
  deliveryAssignments DeliveryAssignment[] @relation("AssignedAgent")
  assignedByRecords   DeliveryAssignment[] @relation("AssignedByStaff")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OtpVerification {
  id         String    @id @default(cuid())
  userId     String?
  target     String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose])
}

// ============================================================================
// 2. CUSTOMER & ADDRESSES
// ============================================================================

model CustomerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  defaultPhone String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  carts     Cart[]
  wishlists Wishlist[]
  orders    Order[]
  reviews   Review[]
}

model Address {
  id                String    @id @default(cuid())
  customerProfileId String
  deliveryZoneId    String?
  label             String
  recipientName     String
  recipientPhone    String
  city              String    @default("Addis Ababa")
  subCity           String?
  woreda            String?
  streetAddress     String
  landmark          String?
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  isDefault         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  deliveryZone    DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  @@index([customerProfileId])
}

// ============================================================================
// 3. CATALOG (PRODUCTS, CATEGORIES, VARIANTS, ATTRIBUTES, IMAGES)
// ============================================================================

model Category {
  id            String    @id @default(cuid())
  parentId      String?
  slug          String    @unique
  nameEn        String
  nameAm        String?
  descriptionEn String?
  descriptionAm String?
  imageUrl      String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Attribute {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAm    String?
  createdAt DateTime @default(now())

  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(cuid())
  attributeId String
  valueEn     String
  valueAm     String?
  sortOrder   Int    @default(0)

  attribute    Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantLinks ProductVariantAttribute[]

  @@unique([attributeId, valueEn])
}

model Product {
  id            String        @id @default(cuid())
  categoryId    String
  slug          String        @unique
  nameEn        String
  nameAm        String?
  subtitleEn    String?
  subtitleAm    String?
  descriptionEn String?
  descriptionAm String?
  brand         String?
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  isReturnable  Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  @@index([categoryId])
  @@index([status, isFeatured])
  @@index([createdAt])
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  sku            String    @unique
  nameEn         String
  nameAm         String?
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  costPrice      Decimal?  @db.Decimal(12, 2)
  weightGrams    Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  product           Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes        ProductVariantAttribute[]
  images            ProductImage[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]

  @@index([productId])
  @@index([isActive])
}

model ProductVariantAttribute {
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

// ============================================================================
// 4. INVENTORY & WAREHOUSES
// ============================================================================

model Warehouse {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  city      String    @default("Addis Ababa")
  address   String?
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
}

model InventoryItem {
  id                String   @id @default(cuid())
  warehouseId       String
  variantId         String
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model StockMovement {
  id            String            @id @default(cuid())
  warehouseId   String
  variantId     String
  type          StockMovementType
  quantityDelta Int
  unitCost      Decimal?          @db.Decimal(12, 2)
  reason        String
  referenceType String?
  referenceId   String?
  actorId       String?
  createdAt     DateTime          @default(now())

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([warehouseId, variantId, createdAt])
  @@index([referenceType, referenceId])
}

model StockReservation {
  id          String                 @id @default(cuid())
  warehouseId String
  variantId   String
  orderId     String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  releasedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orderId])
}

// ============================================================================
// 5. SHOPPING (CART & WISHLIST)
// ============================================================================

model Cart {
  id                String   @id @default(cuid())
  customerProfileId String?
  guestSessionId    String?  @unique
  couponCode        String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  items           CartItem[]

  @@index([customerProfileId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  id                String   @id @default(cuid())
  customerProfileId String   @unique
  createdAt         DateTime @default(now())

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  items           WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  variantId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, variantId])
}

// ============================================================================
// 6. SALES & ORDERS (WITH IMMUTABLE SNAPSHOTS)
// ============================================================================

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique
  idempotencyKey     String        @unique
  customerProfileId  String
  status             OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod      PaymentMethod
  currency           String        @default("ETB")
  subtotal           Decimal       @db.Decimal(12, 2)
  discountTotal      Decimal       @db.Decimal(12, 2) @default(0)
  deliveryFee        Decimal       @db.Decimal(12, 2) @default(0)
  taxTotal           Decimal       @db.Decimal(12, 2) @default(0)
  grandTotal         Decimal       @db.Decimal(12, 2)
  couponId           String?
  couponCodeSnapshot String?
  customerNote       String?
  cancellationReason String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customerProfile   CustomerProfile    @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  shippingAddress   OrderAddress?
  stockReservations StockReservation[]
  payments          Payment[]
  delivery          Delivery?
  returnRequests    ReturnRequest[]

  @@index([customerProfileId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  variantId           String?
  productNameSnapshot String
  variantNameSnapshot String
  skuSnapshot         String
  imageUrlSnapshot    String?
  quantity            Int
  unitPrice           Decimal @db.Decimal(12, 2)
  discountAmount      Decimal @db.Decimal(12, 2) @default(0)
  lineTotal           Decimal @db.Decimal(12, 2)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
}

model OrderAddress {
  id             String   @id @default(cuid())
  orderId        String   @unique
  deliveryZoneId String?
  zoneName       String?
  recipientName  String
  recipientPhone String
  city           String
  subCity        String?
  woreda         String?
  streetAddress  String
  landmark       String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 7. PAYMENTS & REFUNDS
// ============================================================================

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("ETB")
  paidAt          DateTime?
  codCollectedAt  DateTime?
  codReconciledAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status])
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  paymentId         String
  provider          String
  providerReference String                   @unique
  webhookEventId    String?                  @unique
  status            PaymentTransactionStatus @default(INITIALIZED)
  amount            Decimal                  @db.Decimal(12, 2)
  checkoutUrl       String?
  rawRequest        Json?
  rawResponse       Json?
  verifiedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  returnRequestId   String?
  status            RefundStatus @default(REQUESTED)
  amount            Decimal      @db.Decimal(12, 2)
  reason            String
  providerReference String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
}

// ============================================================================
// 8. DELIVERY OPERATIONS
// ============================================================================

model DeliveryZone {
  id                    String   @id @default(cuid())
  name                  String   @unique
  city                  String   @default("Addis Ababa")
  fee                   Decimal  @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(12, 2)
  estimatedDaysMin      Int      @default(1)
  estimatedDaysMax      Int      @default(2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  addresses  Address[]
  deliveries Delivery[]
}

model Delivery {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  deliveryZoneId      String?
  assignedAgentId     String?
  status              DeliveryStatus @default(UNASSIGNED)
  trackingCode        String         @unique
  proofOfDeliveryUrl  String?
  proofOfDeliveryCode String?
  recipientSignedName String?
  codAmountExpected   Decimal        @db.Decimal(12, 2) @default(0)
  codAmountCollected  Decimal        @db.Decimal(12, 2) @default(0)
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  assignments  DeliveryAssignment[]
  attempts     DeliveryAttempt[]

  @@index([assignedAgentId, status])
  @@index([status])
}

model DeliveryAssignment {
  id           String    @id @default(cuid())
  deliveryId   String
  agentId      String
  assignedById String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  note         String?

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  agent      User     @relation("AssignedAgent", fields: [agentId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignedByStaff", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([agentId])
}

model DeliveryAttempt {
  id            String         @id @default(cuid())
  deliveryId    String
  attemptNumber Int
  status        DeliveryStatus
  note          String?
  photoUrl      String?
  attemptedAt   DateTime       @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

// ============================================================================
// 9. MARKETING (COUPONS & PROMOTIONS)
// ============================================================================

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]
}

model Promotion {
  id            String       @id @default(cuid())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ============================================================================
// 10. ENGAGEMENT (REVIEWS)
// ============================================================================

model Review {
  id                 String   @id @default(cuid())
  productId          String
  customerProfileId  String
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean  @default(false)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  images          ReviewImage[]

  @@unique([productId, customerProfileId])
  @@index([productId, isPublished])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 11. RETURNS
// ============================================================================

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  status       ReturnStatus @default(REQUESTED)
  reason       String
  customerNote String?
  staffNote    String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id              String          @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  restockDecision RestockDecision @default(PENDING)
  restockedAt     DateTime?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
}

// ============================================================================
// 12. OPERATIONS (NOTIFICATIONS, AUDIT LOGS, SETTINGS)
// ============================================================================

model NotificationTemplate {
  id        String              @id @default(cuid())
  code      String              @unique
  channel   NotificationChannel
  subjectEn String?
  subjectAm String?
  bodyEn    String
  bodyAm    String?
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model BusinessSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
