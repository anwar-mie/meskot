{
  "name": "meskot-ecommerce",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "bun test packages apps/api/src",
    "test:e2e": "playwright test",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun run --cwd packages/database db:migrate",
    "db:push": "bun run --cwd packages/database db:push",
    "db:seed": "bun run --cwd packages/database db:seed",
    "db:studio": "bun run --cwd packages/database db:studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
