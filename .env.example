# Database (PostgreSQL 16)
DATABASE_URL="postgresql://meskot:meskot_dev_password@localhost:5432/meskot_db?schema=public"

# Redis (Cache, Rate Limiting & BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# MinIO / S3 Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="meskot-media"
S3_ACCESS_KEY="meskot_minio"
S3_SECRET_KEY="meskot_minio_secret"
S3_PUBLIC_URL="http://localhost:9000/meskot-media"

# NestJS API
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-strong-32-char-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-32-char-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Payments (Chapa + Mock)
PAYMENT_DEFAULT_ONLINE_PROVIDER="MOCK_ONLINE" # "CHAPA" | "MOCK_ONLINE"
CHAPA_SECRET_KEY="CHASECK_TEST-replace-me"
CHAPA_WEBHOOK_SECRET="replace-with-chapa-webhook-secret"
CHAPA_BASE_URL="https://api.chapa.co/v1"

# Next.js Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
